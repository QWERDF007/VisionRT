format_version: 1
project:
  name: 节点错误诊断复现工程
  next_node_seq: 5
  next_flow_seq: 2
flows:
- flow_id: flow_1
  name: 错误诊断复现流程
  run_selected: true
  nodes:
  - node_seq: 1
    tool_id: visionrt.image.read
    tool_name_snapshot: 图像读取
    alias: 正常读图
    pos:
    - 60
    - 80
    init_params: {}
    type_snapshot:
      init_params: {}
      inputs:
        mode:
          type: String
        path:
          type: String
        color:
          type: String
        limit:
          type: Int
      outputs:
        images:
          type: ImageBatch
        paths:
          type: StringArray
          rank: 1
          layout: dense
    inputs:
      mode:
        mode: literal
        literal: directory
      path:
        mode: literal
        literal: images
      color:
        mode: literal
        literal: bgr
      limit:
        mode: literal
        literal: 0
  - node_seq: 2
    tool_id: visionrt.image.crop
    tool_name_snapshot: 图像裁剪
    alias: 裁剪(缺ROI输入负例)
    pos:
    - 300
    - 80
    init_params: {}
    type_snapshot:
      init_params: {}
      inputs:
        images:
          type: ImageBatch
        rois:
          type: RoiBatch
      outputs:
        images:
          type: ImageBatch
        source_indices:
          type: NumericArray
          dtype: int64
          rank: 2
          layout: dense
        origins:
          type: NumericArray
          dtype: float64
          rank: 2
          layout: dense
    inputs:
      images:
        mode: upstream
        source:
          node_seq: 1
          port_id: images
      rois:
        mode: literal
        literal: null
  - node_seq: 3
    tool_id: visionrt.dl.yolo
    tool_name_snapshot: YOLO目标检测
    alias: YOLO(缺模型文件负例)
    pos:
    - 300
    - 240
    init_params:
      model_name: yolov8n
      load_mode: onnx
      model_path: nonexistent_weights.onnx
      engine_output_path: nonexistent_weights.engine
      labels_path: ''
      precision: fp16
      gpu_index: 0
      input_width: 640
      input_height: 640
      num_classes: 80
    type_snapshot:
      init_params:
        model_name:
          type: String
        load_mode:
          type: String
        model_path:
          type: String
        engine_output_path:
          type: String
        labels_path:
          type: String
        precision:
          type: String
        gpu_index:
          type: Int
        input_width:
          type: Int
        input_height:
          type: Int
        num_classes:
          type: Int
      inputs:
        images:
          type: ImageBatch
        conf_threshold:
          type: Float
        nms_threshold:
          type: Float
        max_detections:
          type: Int
      outputs:
        images:
          type: ImageBatch
        rois:
          type: RoiBatch
        scores:
          type: NumericArray
          dtype: float32
          rank: 2
          layout: batch_ragged
        classes:
          type: NumericArray
          dtype: int64
          rank: 2
          layout: batch_ragged
        class_names:
          type: StringArray
          rank: 2
          layout: batch_ragged
    inputs:
      images:
        mode: upstream
        source:
          node_seq: 1
          port_id: images
      conf_threshold:
        mode: literal
        literal: 0.25
      nms_threshold:
        mode: literal
        literal: 0.45
      max_detections:
        mode: literal
        literal: 300
- flow_id: flow_missing
  name: 未定义算子测试流程
  run_selected: false
  nodes:
  - node_seq: 4
    tool_id: unavailable.custom.plugin
    tool_name_snapshot: 未定义算子
    alias: 算子缺失负例
    pos:
    - 540
    - 240
    init_params: {}
    type_snapshot:
      init_params: {}
      inputs:
        images:
          type: ImageBatch
      outputs:
        images:
          type: ImageBatch
    inputs:
      images:
        mode: upstream
        source:
          node_seq: 1
          port_id: images
