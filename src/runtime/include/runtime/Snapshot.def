VRT_ENUM_BEGIN(NodeDisposition, int)
VRT_ENUM_VALUE(Pending, 0)
VRT_ENUM_VALUE(Running, 1)
VRT_ENUM_VALUE(Succeeded, 2)
VRT_ENUM_VALUE(Failed, 3)
VRT_ENUM_VALUE(Canceled, 4)
VRT_ENUM_END(NodeDisposition)
VRT_ENUM_BEGIN(NodePhase, int)
VRT_ENUM_VALUE(Create, 0)
VRT_ENUM_VALUE(Prepare, 1)
VRT_ENUM_VALUE(Initialize, 2)
VRT_ENUM_VALUE(Execute, 3)
VRT_ENUM_VALUE(Convert, 4)
VRT_ENUM_VALUE(Release, 5)
VRT_ENUM_END(NodePhase)
