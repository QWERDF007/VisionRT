include_guard(GLOBAL)

function(visionrt_dependency_default dependency_name output_var)
    set(_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/dependencies.json")
    if(DEFINED VISIONRT_DEPENDENCY_MANIFEST AND NOT "${VISIONRT_DEPENDENCY_MANIFEST}" STREQUAL "")
        set(_manifest "${VISIONRT_DEPENDENCY_MANIFEST}")
    endif()
    if(NOT EXISTS "${_manifest}")
        message(FATAL_ERROR "Dependency manifest not found: ${_manifest}")
    endif()

    file(READ "${_manifest}" _json)
    string(JSON _count LENGTH "${_json}" dependencies)
    set(_keys default)
    if(WIN32)
        list(PREPEND _keys windows_default)
    elseif(APPLE)
        list(PREPEND _keys macos_default)
    elseif(UNIX)
        list(PREPEND _keys linux_default)
    endif()
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _name GET "${_json}" dependencies ${_index} name)
            if(NOT _name STREQUAL "${dependency_name}")
                continue()
            endif()
            foreach(_key IN LISTS _keys)
                string(JSON _value ERROR_VARIABLE _error GET "${_json}" dependencies ${_index} ${_key})
                if(NOT _error AND NOT "${_value}" STREQUAL "")
                    set(${output_var} "${_value}" PARENT_SCOPE)
                    return()
                endif()
            endforeach()
            set(${output_var} "" PARENT_SCOPE)
            return()
        endforeach()
    endif()
    message(FATAL_ERROR "Dependency '${dependency_name}' not declared in ${_manifest}.")
endfunction()

# 统一依赖路径解析单一真相源 (SSOT)
# 优先级：CMake 显式变量 > 环境变量 > CMAKE_PREFIX_PATH 候选匹配 > tools/dependencies.json 清单默认值
function(visionrt_resolve_path output_var)
    cmake_parse_arguments(ARG "" "DEPENDENCY;REQUIRED_FILE" "VARIABLES;ENVIRONMENT_VARIABLES;PATHS" ${ARGN})

    set(_candidates)

    # 1. CMake 变量（包括命令行 -D 传入）
    foreach(_var IN LISTS ARG_VARIABLES)
        if(DEFINED ${_var} AND NOT "${${_var}}" STREQUAL "")
            file(TO_CMAKE_PATH "${${_var}}" _var_norm)
            list(APPEND _candidates "${_var_norm}")
        endif()
    endforeach()

    # 2. 操作系统环境变量 (将 Windows 反斜杠规范化为 CMake 正斜杠)
    foreach(_env IN LISTS ARG_ENVIRONMENT_VARIABLES)
        if(DEFINED ENV{${_env}} AND NOT "$ENV{${_env}}" STREQUAL "")
            file(TO_CMAKE_PATH "$ENV{${_env}}" _env_norm)
            list(APPEND _candidates "${_env_norm}")
        endif()
    endforeach()

    # 3. 候选路径匹配
    foreach(_p IN LISTS ARG_PATHS)
        if(_p)
            file(TO_CMAKE_PATH "${_p}" _p_norm)
            list(APPEND _candidates "${_p_norm}")
        endif()
    endforeach()

    # 4. tools/dependencies.json 清单默认值（机器差异唯一改动点）
    if(ARG_DEPENDENCY)
        visionrt_dependency_default("${ARG_DEPENDENCY}" _manifest_default)
        if(_manifest_default)
            file(TO_CMAKE_PATH "${_manifest_default}" _def_norm)
            list(APPEND _candidates "${_def_norm}")
        endif()
    endif()

    foreach(_cand IN LISTS _candidates)
        if(EXISTS "${_cand}")
            if(ARG_REQUIRED_FILE)
                if(EXISTS "${_cand}/${ARG_REQUIRED_FILE}")
                    set(${output_var} "${_cand}" PARENT_SCOPE)
                    return()
                endif()
            else()
                set(${output_var} "${_cand}" PARENT_SCOPE)
                return()
            endif()
        endif()
    endforeach()

    set(${output_var} "" PARENT_SCOPE)
endfunction()
