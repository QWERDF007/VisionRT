cmake_minimum_required(VERSION 3.25)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
if(NOT DEFINED DESTINATION)
    set(DESTINATION "@CMAKE_BINARY_DIR@/dist/VisionRT")
endif()
file(MAKE_DIRECTORY "${DESTINATION}")
set(host_executable "$<TARGET_FILE:VisionRT>")
set(bridge_library "$<TARGET_FILE:visionrt_python_bridge>")
file(COPY "${host_executable}" "${bridge_library}" DESTINATION "${DESTINATION}")

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${host_executable}"
    LIBRARIES "${bridge_library}"
    DIRECTORIES "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@" "@VISIONRT_OPENCV_BIN@" "@VISIONRT_QT_BIN@" "@VISIONRT_QUICKUI_QML_ROOT@/quickui"
    RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*" "[Pp][Yy][Tt][Hh][Oo][Nn]3.*" "[Vv][Cc][Rr][Uu][Nn][Tt][Ii][Mm][Ee]140.*" "[Mm][Ss][Vv][Cc][Pp]140.*" "[Uu][Cc][Rr][Tt][Bb][Aa][Ss][Ee].*"
    POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32.*")
if(unresolved)
    message(FATAL_ERROR "Unresolved portable runtime dependencies: ${unresolved}")
endif()
file(COPY ${dependencies} DESTINATION "${DESTINATION}")
file(READ "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/visionrt-modules.json" modules)
string(JSON module_count LENGTH "${modules}" modules)
math(EXPR last_module "${module_count} - 1")
foreach(index RANGE ${last_module})
    string(JSON library GET "${modules}" modules ${index} library)
    string(JSON metadata GET "${modules}" modules ${index} metadata)
    if(NOT EXISTS "${DESTINATION}/${library}")
        message(FATAL_ERROR "Module is outside the dependency closure: ${library}")
    endif()
    file(COPY "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/${metadata}" DESTINATION "${DESTINATION}")
endforeach()
file(COPY "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/visionrt-modules.json"
    "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/build_info.json"
    "@CMAKE_RUNTIME_OUTPUT_DIRECTORY@/contracts-build-info.json"
    DESTINATION "${DESTINATION}")
execute_process(COMMAND "@VISIONRT_WINDEPLOYQT@" "$<IF:$<CONFIG:Debug>,--debug,--release>" --no-translations
    --qmldir "@CMAKE_SOURCE_DIR@/src/ui/qml"
    --qmlimport "@VISIONRT_QUICKUI_QML_ROOT@"
    --dir "${DESTINATION}" "${DESTINATION}/VisionRT.exe"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "windeployqt failed: ${result}")
endif()
file(COPY "@VISIONRT_QUICKUI_QML_ROOT@/quickui" DESTINATION "${DESTINATION}/qml")
if(EXISTS "@CMAKE_SOURCE_DIR@/assets/tools")
    file(COPY "@CMAKE_SOURCE_DIR@/assets/tools/" DESTINATION "${DESTINATION}/tools"
        PATTERN "__pycache__" EXCLUDE)
endif()
if(EXISTS "@CMAKE_SOURCE_DIR@/examples")
    file(COPY "@CMAKE_SOURCE_DIR@/examples/" DESTINATION "${DESTINATION}/examples"
        PATTERN "__pycache__" EXCLUDE)
endif()

file(WRITE "${DESTINATION}/qt.conf" "[Paths]\nPrefix=.\nPlugins=.\nQmlImports=qml\n")
file(MAKE_DIRECTORY "${DESTINATION}/licenses")
file(COPY "@CMAKE_SOURCE_DIR@/LICENSE" DESTINATION "${DESTINATION}/licenses/VisionRT")
file(COPY "@CMAKE_SOURCE_DIR@/3rdparty/QuickUI/LICENSE" DESTINATION "${DESTINATION}/licenses/QuickUI")
file(COPY "@CMAKE_SOURCE_DIR@/3rdparty/pybind11/LICENSE" DESTINATION "${DESTINATION}/licenses/pybind11")
file(COPY "@CMAKE_SOURCE_DIR@/3rdparty/taskflow/LICENSE" DESTINATION "${DESTINATION}/licenses/Taskflow")
message(STATUS "Portable directory: ${DESTINATION}")
