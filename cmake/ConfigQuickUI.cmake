include_guard(GLOBAL)

if(NOT TARGET quickui::quickui)
    find_package(quickui CONFIG QUIET)
    if(NOT TARGET quickui::quickui AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/3rdparty/QuickUI/CMakeLists.txt")
        add_subdirectory(3rdparty/QuickUI EXCLUDE_FROM_ALL)
    endif()
endif()

if(TARGET quickui::quickui)
    get_target_property(_is_imported quickui::quickui IMPORTED)
    if(_is_imported)
        get_target_property(VISIONRT_QUICKUI_DLL quickui::quickui IMPORTED_LOCATION_RELEASE)
        if(NOT VISIONRT_QUICKUI_DLL)
            get_target_property(VISIONRT_QUICKUI_DLL quickui::quickui LOCATION)
        endif()
        get_filename_component(VISIONRT_QUICKUI_MODULE "${VISIONRT_QUICKUI_DLL}" DIRECTORY)
        get_filename_component(VISIONRT_QUICKUI_QML_ROOT "${VISIONRT_QUICKUI_MODULE}" DIRECTORY)
    else()
        set(VISIONRT_QUICKUI_DLL "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/quickui.dll")
        set(VISIONRT_QUICKUI_QML_ROOT "${CMAKE_BINARY_DIR}/qml")
    endif()
endif()
