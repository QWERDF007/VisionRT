{
  "schema_version": 3,
  "tool_id": "visiontools.image.brightness",
  "display_name": "调整亮度",
  "version": "1.0.0",
  "kind": "cpp",
  "category": "预处理",
  "init_params": [],
  "inputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "gain",
      "name": "增益",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 0.0
    },
    {
      "id": "offset",
      "name": "偏移",
      "type": "Float",
      "required": true,
      "default": 0.0
    },
    {
      "id": "rois",
      "name": "ROI",
      "type": "ROI",
      "required": true,
      "default": [],
      "editor": "roi",
      "image_input": "images",
      "alignment_input": "alignment"
    },
    {
      "id": "mask",
      "name": "输入掩码",
      "type": "Image",
      "required": false
    },
    {
      "id": "alignment",
      "name": "参考到当前变换",
      "type": "Array",
      "required": true,
      "default": [],
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "emit_mask",
      "name": "输出应用区域",
      "type": "Bool",
      "required": true,
      "default": false
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "输出图像",
      "type": "Image",
      "required": true,
      "display": {
        "same_geometry_as_input": "images"
      }
    },
    {
      "id": "applied_mask",
      "name": "应用区域",
      "type": "Image",
      "required": false,
      "display": {
        "same_geometry_as_input": "images",
        "color_order": "GRAY"
      }
    }
  ]
}
