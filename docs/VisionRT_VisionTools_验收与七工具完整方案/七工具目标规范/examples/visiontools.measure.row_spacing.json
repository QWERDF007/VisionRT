{
  "schema_version": 3,
  "tool_id": "visiontools.measure.row_spacing",
  "display_name": "测量行间距",
  "version": "1.0.0",
  "kind": "cpp",
  "category": "测量",
  "init_params": [],
  "inputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "rois",
      "name": "ROI",
      "type": "ROI",
      "required": true,
      "default": [],
      "editor": "roi",
      "image_input": "images",
      "alignment_input": "alignment"
    },
    {
      "id": "alignment",
      "name": "参考到当前变换",
      "type": "Array",
      "required": true,
      "default": [],
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "sigma",
      "name": "平滑标准差",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 0.1,
      "max": 20.0
    },
    {
      "id": "min_gradient",
      "name": "最小梯度",
      "type": "Float",
      "required": true,
      "default": 8.0,
      "min": 0.0,
      "max": 255.0
    },
    {
      "id": "object_polarity",
      "name": "物体极性",
      "type": "String",
      "required": true,
      "default": "bright",
      "options": [
        "bright",
        "dark"
      ]
    },
    {
      "id": "width_min",
      "name": "合格宽度下限",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 0.0
    },
    {
      "id": "width_max",
      "name": "合格宽度上限",
      "type": "Float",
      "required": true,
      "default": 1000000.0,
      "min": 0.0
    },
    {
      "id": "units_per_pixel",
      "name": "每像素物理长度",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 1e-09
    },
    {
      "id": "unit",
      "name": "单位",
      "type": "String",
      "required": true,
      "default": "px"
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "显示图像",
      "type": "Image",
      "required": true,
      "display": {
        "same_geometry_as_input": "images"
      }
    },
    {
      "id": "valid_roi",
      "name": "逐ROI有效性",
      "type": "Array",
      "required": true,
      "dtype": "bool",
      "rank": 2
    },
    {
      "id": "reasons",
      "name": "逐ROI说明",
      "type": "Array",
      "required": true,
      "dtype": "string",
      "rank": 2
    },
    {
      "id": "pair_count",
      "name": "完整物体数量",
      "type": "Array",
      "required": true,
      "dtype": "int64",
      "rank": 2
    },
    {
      "id": "accepted_count",
      "name": "宽度合格数量",
      "type": "Array",
      "required": true,
      "dtype": "int64",
      "rank": 2
    },
    {
      "id": "unpaired_count",
      "name": "未配对边缘数量",
      "type": "Array",
      "required": true,
      "dtype": "int64",
      "rank": 2
    },
    {
      "id": "accepted",
      "name": "逐物体宽度合格",
      "type": "Array",
      "required": true,
      "dtype": "bool",
      "rank": 3
    },
    {
      "id": "width_px",
      "name": "宽度像素值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "gap_px",
      "name": "间隙像素值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "pitch_px",
      "name": "节距像素值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "width",
      "name": "宽度物理值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "gap",
      "name": "间隙物理值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "pitch",
      "name": "节距物理值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "pair_points",
      "name": "物体边缘中点",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 4
    },
    {
      "id": "overlay_segments",
      "name": "边缘显示线段",
      "type": "ROI",
      "required": true,
      "image_port": "images"
    },
    {
      "id": "unit",
      "name": "单位",
      "type": "String",
      "required": true
    }
  ],
  "interaction": {
    "helper_tool_id": "visiontools.assist.row_spacing",
    "roi_input": "rois",
    "allowed_roi_kinds": [
      2
    ],
    "input_map": {
      "images": {
        "input": "images",
        "selection": "current_image"
      },
      "seed_rois": {
        "input": "rois",
        "selection": "current_image"
      },
      "alignment": {
        "input": "alignment",
        "selection": "current_image"
      }
    },
    "proposal_map": {
      "proposal_rois": "rois",
      "suggested_polarity": "object_polarity",
      "suggested_width_min": "width_min",
      "suggested_width_max": "width_max"
    }
  }
}
