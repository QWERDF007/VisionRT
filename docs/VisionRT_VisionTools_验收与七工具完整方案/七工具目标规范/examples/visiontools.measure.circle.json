{
  "schema_version": 3,
  "tool_id": "visiontools.measure.circle",
  "display_name": "测量圆",
  "version": "1.0.0",
  "kind": "cpp",
  "category": "测量",
  "init_params": [],
  "inputs": [
    {
      "id": "images",
      "name": "图像",
      "type": "Image",
      "required": true
    },
    {
      "id": "rois",
      "name": "ROI",
      "type": "ROI",
      "required": true,
      "default": [],
      "editor": "roi",
      "image_input": "images",
      "alignment_input": "alignment"
    },
    {
      "id": "alignment",
      "name": "参考到当前变换",
      "type": "Array",
      "required": true,
      "default": [],
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "num_calipers",
      "name": "卡尺数量",
      "type": "Int",
      "required": true,
      "default": 64,
      "min": 12,
      "max": 4096
    },
    {
      "id": "search_half_width",
      "name": "径向半搜索宽度",
      "type": "Float",
      "required": true,
      "default": 8.0,
      "min": 0.5,
      "max": 4096.0
    },
    {
      "id": "average_width",
      "name": "切向平均宽度",
      "type": "Float",
      "required": true,
      "default": 3.0,
      "min": 1.0,
      "max": 1024.0
    },
    {
      "id": "sigma",
      "name": "平滑标准差",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 0.1,
      "max": 20.0
    },
    {
      "id": "min_gradient",
      "name": "最小梯度",
      "type": "Float",
      "required": true,
      "default": 8.0,
      "min": 0.0,
      "max": 255.0
    },
    {
      "id": "polarity",
      "name": "边缘极性",
      "type": "String",
      "required": true,
      "default": "any",
      "options": [
        "any",
        "dark_to_light",
        "light_to_dark"
      ]
    },
    {
      "id": "min_points",
      "name": "最少有效点",
      "type": "Int",
      "required": true,
      "default": 12,
      "min": 3,
      "max": 4096
    },
    {
      "id": "min_completeness",
      "name": "最小完整度",
      "type": "Float",
      "required": true,
      "default": 0.6,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "min_coverage_deg",
      "name": "最小覆盖角度",
      "type": "Float",
      "required": true,
      "default": 180.0,
      "min": 0.0,
      "max": 360.0
    },
    {
      "id": "radius_min",
      "name": "最小半径",
      "type": "Float",
      "required": true,
      "default": 0.5,
      "min": 0.0
    },
    {
      "id": "radius_max",
      "name": "最大半径",
      "type": "Float",
      "required": true,
      "default": 1000000.0,
      "min": 0.0
    },
    {
      "id": "max_rms",
      "name": "最大拟合均方根误差",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 0.0
    },
    {
      "id": "units_per_pixel",
      "name": "每像素物理长度",
      "type": "Float",
      "required": true,
      "default": 1.0,
      "min": 1e-09
    },
    {
      "id": "unit",
      "name": "单位",
      "type": "String",
      "required": true,
      "default": "px"
    }
  ],
  "outputs": [
    {
      "id": "images",
      "name": "显示图像",
      "type": "Image",
      "required": true,
      "display": {
        "same_geometry_as_input": "images"
      }
    },
    {
      "id": "valid",
      "name": "逐ROI有效性",
      "type": "Array",
      "required": true,
      "dtype": "bool",
      "rank": 2
    },
    {
      "id": "reasons",
      "name": "逐ROI说明",
      "type": "Array",
      "required": true,
      "dtype": "string",
      "rank": 2
    },
    {
      "id": "valid_count",
      "name": "逐图有效圆数量",
      "type": "Array",
      "required": true,
      "dtype": "int64",
      "rank": 1
    },
    {
      "id": "source_roi_indices",
      "name": "有效圆来源索引",
      "type": "Array",
      "required": true,
      "dtype": "int64",
      "rank": 2
    },
    {
      "id": "circles",
      "name": "测得圆",
      "type": "ROI",
      "required": true,
      "image_port": "images"
    },
    {
      "id": "centers",
      "name": "圆心坐标",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 3
    },
    {
      "id": "radius_px",
      "name": "半径像素值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 2
    },
    {
      "id": "radius",
      "name": "半径物理值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 2
    },
    {
      "id": "rms",
      "name": "拟合误差像素值",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 2
    },
    {
      "id": "completeness",
      "name": "完整度",
      "type": "Array",
      "required": true,
      "dtype": "float64",
      "rank": 2
    },
    {
      "id": "used_edges",
      "name": "拟合边缘点",
      "type": "ROI",
      "required": true,
      "image_port": "images"
    },
    {
      "id": "unit",
      "name": "单位",
      "type": "String",
      "required": true
    }
  ],
  "interaction": {
    "helper_tool_id": "visiontools.assist.circle",
    "roi_input": "rois",
    "allowed_roi_kinds": [
      3
    ],
    "input_map": {
      "images": {
        "input": "images",
        "selection": "current_image"
      },
      "seed_rois": {
        "input": "rois",
        "selection": "current_image"
      },
      "alignment": {
        "input": "alignment",
        "selection": "current_image"
      }
    },
    "proposal_map": {
      "proposal_rois": "rois",
      "suggested_polarity": "polarity",
      "suggested_search_half_width": "search_half_width"
    }
  }
}
