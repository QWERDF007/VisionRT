digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.36", ranksep="0.44", splines=polyline, fontname="sans-serif", label="从文件获取图像", labelloc=t, fontsize=21];
node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=14, margin="0.18,0.13", color="#c5ccd4", fontcolor="#243447", penwidth=1];
edge [fontname="sans-serif", fontsize=12, color="#7e8c9c", fontcolor="#526171", arrowsize=0.7];
"input" [label="RT · JSON参数\nfile / directory / list", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"paths" [label="Tools · 路径解析与目录列表\n工程相对路径 / 排序 / 筛选", shape=box, fillcolor="#f1ecfb", color="#725495"];
"change" [label="来源配置变化或Reset？", shape=diamond, fillcolor="#fff6e2", color="#9c7c36"];
"rebuild" [label="重建路径列表\n索引归零，不缓存像素", shape=box, fillcolor="#f1ecfb", color="#725495"];
"pick" [label="选择本次路径\nall 或 sequence[index]", shape=box, fillcolor="#f1ecfb", color="#725495"];
"decode" [label="OpenCV解码\n检查颜色、格式与字节预算", shape=box, fillcolor="#f1ecfb", color="#725495"];
"ok" [label="整次成功？", shape=diamond, fillcolor="#fff6e2", color="#9c7c36"];
"advance" [label="sequence成功后推进\nwrap / hold / error", shape=box, fillcolor="#f1ecfb", color="#725495"];
"output" [label="图像 · 路径 · 当前索引\n目录数量 · 已到末项", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"error" [label="错误原文返回\n不推进索引，不发布部分图像", shape=box, fillcolor="#fff0ed", color="#ac5c4e"];
"ui" [label="RT · Once完整显示\nLoop只更新轻量状态", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"input" -> "paths" [label=""];
"paths" -> "change" [label=""];
"change" -> "rebuild" [label="是"];
"change" -> "pick" [label="否"];
"rebuild" -> "pick" [label=""];
"pick" -> "decode" [label=""];
"decode" -> "ok" [label=""];
"ok" -> "advance" [label="是"];
"ok" -> "error" [label="否"];
"advance" -> "output" [label=""];
"output" -> "ui" [label=""];
}