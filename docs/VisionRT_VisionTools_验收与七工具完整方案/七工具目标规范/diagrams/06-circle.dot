digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.36", ranksep="0.44", splines=polyline, fontname="sans-serif", label="测量圆", labelloc=t, fontsize=21];
node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=14, margin="0.18,0.13", color="#c5ccd4", fontcolor="#243447", penwidth=1];
edge [fontname="sans-serif", fontsize=12, color="#7e8c9c", fontcolor="#526171", arrowsize=0.7];
"in" [label="图像 · 圆ROI · alignment\n卡尺 / 极性 / 阈值 / 单位比例", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"sample" [label="Tools · 相似变换与灰度\n均匀径向卡尺，切向平均", shape=box, fillcolor="#f1ecfb", color="#725495"];
"edge" [label="Gaussian导数与峰筛选\n亚像素插值，每卡尺至多一点", shape=box, fillcolor="#f1ecfb", color="#725495"];
"fit" [label="OpenCV SVD初值\nHuber几何拟合与异常点剔除", shape=box, fillcolor="#f1ecfb", color="#725495"];
"valid" [label="点数 / 完整度 / 角覆盖\n半径 / RMS均达标？", shape=diamond, fillcolor="#fff6e2", color="#9c7c36"];
"yes" [label="有效圆压缩输出\nsource_roi_indices保留来源", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"no" [label="该ROI无有效圆\nvalid=false及原因", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"output" [label="圆 · 圆心 · 半径 · 边缘点\n无检出也可执行成功", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"err" [label="配置或图像非法\n工具失败，业务输出Missing", shape=box, fillcolor="#fff0ed", color="#ac5c4e"];
"ui" [label="RT · 单次绘制圆与边缘\nLoop仅耗时与状态", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"in" -> "sample" [label="合法"];
"in" -> "err" [label="非法"];
"sample" -> "edge" [label=""];
"edge" -> "fit" [label="足够候选点"];
"edge" -> "no" [label="不足"];
"fit" -> "valid" [label=""];
"valid" -> "yes" [label="是"];
"valid" -> "no" [label="否"];
"yes" -> "output" [label=""];
"no" -> "output" [label=""];
"output" -> "ui" [label=""];
}