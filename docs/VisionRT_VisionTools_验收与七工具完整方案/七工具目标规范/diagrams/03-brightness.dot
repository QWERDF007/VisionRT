digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.36", ranksep="0.44", splines=polyline, fontname="sans-serif", label="调整亮度", labelloc=t, fontsize=21];
node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=14, margin="0.18,0.13", color="#c5ccd4", fontcolor="#243447", penwidth=1];
edge [fontname="sans-serif", fontsize=12, color="#7e8c9c", fontcolor="#526171", arrowsize=0.7];
"in" [label="图像 · gain · offset\nROI · mask · alignment", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"check" [label="Tools · 先校验全部输入\n类型 / 数量 / 尺寸 / 坐标", shape=box, fillcolor="#f1ecfb", color="#725495"];
"region" [label="映射ROI并取区域\nROI并集 ∩ mask ∩ 图像", shape=box, fillcolor="#f1ecfb", color="#725495"];
"adjust" [label="OpenCV线性转换\ngain × pixel + offset", shape=box, fillcolor="#f1ecfb", color="#725495"];
"merge" [label="区域内合成新图像\n保持区域外像素与alpha", shape=box, fillcolor="#f1ecfb", color="#725495"];
"mask" [label="emit_mask？", shape=diamond, fillcolor="#fff6e2", color="#9c7c36"];
"outmask" [label="按需返回实际应用mask", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"out" [label="输出图像\n与输入几何相同", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"skipmask" [label="applied_mask = Missing\n不分配全白大图", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"err" [label="参数错误原文返回\n不输出半组图像", shape=box, fillcolor="#fff0ed", color="#ac5c4e"];
"in" -> "check" [label=""];
"check" -> "region" [label="合法"];
"check" -> "err" [label="非法"];
"region" -> "adjust" [label=""];
"adjust" -> "merge" [label=""];
"merge" -> "out" [label=""];
"merge" -> "mask" [label=""];
"mask" -> "outmask" [label="是"];
"mask" -> "skipmask" [label="否"];
}