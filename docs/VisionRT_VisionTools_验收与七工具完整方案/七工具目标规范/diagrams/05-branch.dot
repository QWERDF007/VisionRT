digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.36", ranksep="0.44", splines=polyline, fontname="sans-serif", label="条件分支与合流", labelloc=t, fontsize=21];
node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=14, margin="0.18,0.13", color="#c5ccd4", fontcolor="#243447", penwidth=1];
edge [fontname="sans-serif", fontsize=12, color="#7e8c9c", fontcolor="#526171", arrowsize=0.7];
"in" [label="Tools Python · 条件表达式\n使用共享AST引擎", shape=box, fillcolor="#f1ecfb", color="#725495"];
"bool" [label="结果严格为Bool？", shape=diamond, fillcolor="#fff6e2", color="#9c7c36"];
"out" [label="on_true 与 on_false\n互斥且完备", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"gate" [label="RT · 本轮guard判定\n数据边与控制边都严格向下", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"a" [label="支路A包装任务\non_true：执行或Skipped", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"b" [label="支路B包装任务\non_false：执行或Skipped", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"join" [label="RT host select\n等待两路终态，仅取被选值", shape=box, fillcolor="#eaf3fc", color="#37698d"];
"value" [label="下游输出值与原Owner\n缺失被选值则Blocked", shape=box, fillcolor="#eaf5ef", color="#42755a"];
"err" [label="条件失败：两路Missing\n不自动走否则分支", shape=box, fillcolor="#fff0ed", color="#ac5c4e"];
"in" -> "bool" [label=""];
"bool" -> "out" [label="是"];
"bool" -> "err" [label="否或异常"];
"out" -> "gate" [label=""];
"gate" -> "a" [label=""];
"gate" -> "b" [label=""];
"a" -> "join" [label="本轮终态"];
"b" -> "join" [label="本轮终态"];
"join" -> "value" [label=""];
}